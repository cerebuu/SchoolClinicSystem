@echo off
cd /d "%~dp0.."
call tools\dependencies.cmd
if errorlevel 1 exit /b 1
powershell -NoProfile -Command "$s = @(Get-ChildItem src,tests -Recurse -Filter *.java | ForEach-Object FullName); $s += @(Get-ChildItem demo -Recurse -Filter *.java | ForEach-Object FullName); javac --release 17 -encoding UTF-8 -cp 'lib/*' -d out-check $s; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; New-Item -ItemType Directory -Force out-check/clinic/app/ui/auth | Out-Null; Copy-Item src/clinic/app/ui/auth/uic-logo.png out-check/clinic/app/ui/auth/uic-logo.png -Force; java '-Djava.awt.headless=true' -cp 'out-check;lib/*' clinic.app.ui.common.UicLogoChecks; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; java '-Djava.awt.headless=true' -cp 'out-check;lib/*' clinic.app.ui.common.PatientLookupFieldChecks; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; java '-Djava.awt.headless=true' -cp 'out-check;lib/*' clinic.app.ui.notifications.NotificationWorkflowChecks; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; java -cp 'out-check;lib/*' PopupSubmissionChecks; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; java -cp 'out-check;lib/*' DesktopChecks --persistent; exit $LASTEXITCODE"
