@echo off
cd /d "%~dp0.."
powershell -NoProfile -Command "$ErrorActionPreference='Stop'; $target=Join-Path (Get-Location) 'lib/h2-2.5.252.jar'; $expected='90B11DC413DA82070EF15FC943282C1408E6FFD34FA68998335FEA8603B5FF20'; if (!(Test-Path -LiteralPath $target)) { New-Item -ItemType Directory -Force lib | Out-Null; $download=$target+'.download'; Invoke-WebRequest -UseBasicParsing 'https://repo.maven.apache.org/maven2/com/h2database/h2/2.5.252/h2-2.5.252.jar' -OutFile $download; if ((Get-FileHash -LiteralPath $download -Algorithm SHA256).Hash -ne $expected) { throw 'H2 download checksum mismatch.' }; Move-Item -LiteralPath $download -Destination $target }; if ((Get-FileHash -LiteralPath $target -Algorithm SHA256).Hash -ne $expected) { throw 'H2 driver checksum mismatch. Restore the pinned driver before launching.' }; exit 0"
